<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootAddHabit"
    android:layout_width="match_parent"

    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="18dp"
    android:background="?attr/colorSurface">

    <!-- Header row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/btnClose"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:tint="@color/active_text_color"
            android:src="@drawable/outline_arrow_left_alt_24"
             />

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/add_habit"
            android:textSize="18sp"
            android:textStyle="bold"
            android:gravity="center"
            android:paddingHorizontal="8dp" />

        <TextView
            android:id="@+id/btnSave"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/save"
            android:textStyle="bold"
            android:textColor="@color/teal_200"
            android:enabled="false"
            android:alpha="0.4" />
    </LinearLayout>


    <!-- Preview -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/preview"
        android:textSize="14sp"
        android:layout_marginBottom="5dp"
        android:layout_marginTop="16dp" />


    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        app:cardCornerRadius="10dp"
        android:backgroundTint="@color/foreground_color"
        android:layout_marginBottom="10dp"
        android:layout_height="70dp">

        <LinearLayout
            android:gravity="center_vertical"
            android:paddingEnd="4dp"
            android:paddingStart="20dp"
            android:layout_gravity="center"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <ImageView
                android:id="@+id/ivPreviewIcon"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/bg_icon_circle"
                android:padding="6dp"
                android:src="@drawable/outline_add_box_24"
                />

            <TextView
                android:layout_weight="1"
                android:id="@+id/tvPreviewName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="18sp"
                android:textColor="@color/active_text_color"
                android:text="@string/reading"
                android:lines="1"
                android:layout_marginStart="15dp"/>


            <CheckBox
                android:clickable="false"
                android:checked="true"
                android:id="@+id/habitCheckBox"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>



    <!-- Habit -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/habit"
        android:textSize="14sp"
        android:layout_marginBottom="5dp"

        android:layout_marginTop="16dp" />

    <!-- Name -->

    <EditText
        android:id="@+id/etHabitName"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:hint="@string/habit_name_hint"
        android:inputType="textCapSentences"
        android:padding="8dp"
        android:background="@drawable/bg_edittext" />


    <!-- Color row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="16dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/color"
            android:textSize="14sp" />

        <View
            android:id="@+id/viewSelectedColor"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/bg_color_swatch" />
    </LinearLayout>

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/colorSwatchContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal" />
    </HorizontalScrollView>

    <!-- Icon row -->
    <LinearLayout
        android:id="@+id/rowIcon"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="16dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/icon"
            android:textSize="14sp" />

        <LinearLayout
            android:id="@+id/btnIconPicker"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:id="@+id/ivSelectedIcon"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/bg_icon_circle"
                android:padding="6dp"
                android:src="@drawable/outline_add_box_24" />


        </LinearLayout>
    </LinearLayout>

    <!-- Tiny note -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/habit_tip"
        android:textSize="12sp"
        android:alpha="0.7"
        android:layout_marginTop="16dp"
        android:textAlignment="center"
        android:layout_marginBottom="8dp" />

</LinearLayout>
