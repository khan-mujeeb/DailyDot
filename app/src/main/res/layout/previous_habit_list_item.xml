<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="70dp"
    app:cardCornerRadius="10dp"
    android:backgroundTint="@color/foreground_color"
    android:layout_marginBottom="10dp">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:paddingVertical="8dp"
        android:paddingHorizontal="16dp">


        <ImageView
            android:layout_alignParentStart="true"
            android:layout_centerInParent="true"
            android:foregroundGravity="center_vertical"
            android:id="@+id/ivPreviewIcon"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/bg_icon_circle"
            android:padding="6dp"
            android:src="@drawable/outline_add_box_24"
            app:tint="@android:color/white" />

        <TextView
            android:layout_marginStart="8dp"
            android:layout_centerInParent="true"
            android:layout_toRightOf="@id/ivPreviewIcon"
            android:id="@+id/habitTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="18sp"
            android:textColor="@color/active_text_color"
            android:text="@string/reading"
            android:lines="1" />

        <androidx.cardview.widget.CardView
            android:layout_alignParentTop="true"
            android:layout_alignParentEnd="true"
            android:id="@+id/cvHabitCompletionStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:backgroundTint="@color/green_700"
            app:cardCornerRadius="8dp">

            <TextView

                android:id="@+id/tvHabitCompletionStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Completed"
                android:textSize="10sp"
                android:textColor="@color/white"
                android:layout_marginHorizontal="6dp"
                android:layout_marginVertical="3dp"/>
        </androidx.cardview.widget.CardView>

    </RelativeLayout>

</com.google.android.material.card.MaterialCardView>
