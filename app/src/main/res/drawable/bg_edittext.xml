<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Background fill -->
    <solid android:color="@android:color/transparent" />

    <!-- Rounded corners -->
    <corners android:radius="10dp" />

    <!-- Border stroke -->
    <stroke
        android:width="1.5dp"
        android:color="#4DFFFFFF" />  <!-- 30% white (looks good in dark mode) -->

    <!-- Inner padding so text doesn't touch border -->
    <padding
        android:left="10dp"
        android:top="8dp"
        android:right="10dp"
        android:bottom="8dp" />
</shape>
